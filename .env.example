VK_URL=http://voight-kampff:8080
MQTT_HOST=mosquitto-broker
MQTT_PORT=1883
MQTT_SERVICE_USERNAME=news
MQTT_SERVICE_API_KEY=your_api_key_here

# Identité MQTT utilisée pour requêter agent-web-search
# Ce user doit exister dans VK avec accès au search agent
SEARCH_USERNAME=news-agent
SEARCH_PASSWORD=your_search_user_password_here

# LLM local
LLM_BASE_URL=https://thebrain.caronboulme.fr/v1
LLM_MODEL=qwen3-vl-8b-instruct
LLAMACPP_API_KEY=your_llamacpp_key_here

# Optionnel
CRAWL_INTERVAL_H=3
SEARCH_TIMEOUT=45
SEARCH_INTER_DELAY=0.3
SEARCH_INIT_DELAY=3
