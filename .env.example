VK_URL=http://voight-kampff:8080
MQTT_HOST=mosquitto-broker
MQTT_PORT=1883
MQTT_SERVICE_USERNAME=news
MQTT_SERVICE_API_KEY=your_api_key_here

# LLM local
LLM_BASE_URL=https://thebrain.caronboulme.fr/v1
LLM_MODEL=gemma-4-12b-it
LLAMACPP_API_KEY=your_llamacpp_key_here

# Optionnel — heures de génération du bulletin (format cron, timezone Europe/Paris)
BULLETIN_HOURS=8,20

# Désactive les vérifications de mise à jour HuggingFace (à activer après premier téléchargement du modèle)
HF_HUB_OFFLINE=1
SEARCH_TIMEOUT=45
SEARCH_INTER_DELAY=0.3
SEARCH_INIT_DELAY=3
